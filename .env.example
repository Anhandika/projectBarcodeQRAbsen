APP_NAME="Absen Digital SMK Bina Utama"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database - Railway automatically provides DATABASE_URL when you attach a
# Postgres service. DATABASE_URL takes precedence over the DB_HOST/DB_PORT/
# DB_DATABASE/DB_USERNAME/DB_PASSWORD variables below, so on Railway you
# generally do not need to set those individually. They remain here as
# fallbacks for local development without a DATABASE_URL.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=absen_barcode
DB_USERNAME=postgres
DB_PASSWORD=
# DB_SSLMODE=prefer

# Session - Strongly recommended to use 'database' in production/Railway
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue - Use 'database' for asynchronous background tasks (Firebase, etc.)
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Attendance Settings
ATTENDANCE_QR_TTL_SECONDS=15
ATTENDANCE_SCHOOL_RADIUS_METERS=80
ATTENDANCE_MAX_ACCURACY_METERS=150
ATTENDANCE_TIMEZONE=Asia/Jakarta
ATTENDANCE_QR_IMAGE_ENDPOINT=https://api.qrserver.com/v1/create-qr-code/

# Firebase Integration (Opsional)
FIREBASE_ENABLED=false
FIREBASE_STORAGE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_ATTENDANCE_COLLECTION=attendance_events
FIREBASE_STORAGE_DEFAULT_BUCKET=

# VITE Firebase (Frontend)
VITE_FIREBASE_AUTH_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

VITE_APP_NAME="${APP_NAME}"

# Trusted Proxies - Required so Laravel generates correct URLs/schemes
# behind Railway's reverse proxy. '*' trusts all proxies.
TRUSTED_PROXIES=*

# Railway Tips:
# 1. DATABASE_URL: Set in Railway variables, Laravel will pick it up automatically
#    and it takes precedence over the individual DB_* variables above.
# 2. APP_KEY: Generate using `php artisan key:generate --show`.
# 3. TRUSTED_PROXIES: Set to '*' if behind Railway's proxy.
# 4. NIXPACKS_PHP_VERSION: 8.2 or 8.3 recommended.
